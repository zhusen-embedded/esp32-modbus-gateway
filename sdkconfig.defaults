# 双 OTA 分区 + 独立 storage 分区放断网缓存
CONFIG_PARTITION_TABLE_CUSTOM=y
CONFIG_PARTITION_TABLE_CUSTOM_FILENAME="partitions.csv"
CONFIG_PARTITION_TABLE_FILENAME="partitions.csv"

CONFIG_ESPTOOLPY_FLASHSIZE_4MB=y

# MQTT over TLS 需要 mbedtls 证书校验
CONFIG_MBEDTLS_CERTIFICATE_BUNDLE=y

# 任务看门狗由各任务自己 reset，不喂 idle 任务
CONFIG_ESP_TASK_WDT_INIT=n

CONFIG_GW_DEVICE_ID="gw-0001"
CONFIG_GW_MQTT_URI="mqtts://broker.example.com:8883"
CONFIG_GW_MQTT_USER="gateway"
CONFIG_GW_POLL_SLOT_MS=125
CONFIG_GW_SLAVE_COUNT=8
CONFIG_GW_REG_COUNT=4
